<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
      android:shortcutId="camera"
      android:icon="@mipmap/shortcut_camera"
      android:shortcutShortLabel="@string/camera">
      <intent
        android:action="com.sadsha.scanner.OPEN_CAMERA"
        android:targetClass="com.sadsha.scanner.MainActivity" 
        android:targetPackage="com.sadsha.scanner" />
    </shortcut>
    <shortcut
      android:shortcutId="ocr"
      android:icon="@mipmap/shortcut_ocr"
      android:shortcutShortLabel="@string/ocr_copy_text">
      <intent
        android:action="com.sadsha.scanner.OCR_CAMERA_CLIPBOARD"
        android:targetClass="com.sadsha.scanner.MainActivity" 
        android:targetPackage="com.sadsha.scanner" />
    </shortcut>
  </shortcuts>
